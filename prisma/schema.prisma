generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────

enum UserRole {
  COMMITTEE_MEMBER
  RESIDENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum FlatStatus {
  OCCUPIED
  VACANT
  UNDER_MAINTENANCE
}

enum OwnershipType {
  OWNER
  TENANT
}

enum CollectionStatus {
  PAID
  PENDING
  OVERDUE
  PARTIAL
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum NoticePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum VehicleType {
  CAR
  BIKE
  BICYCLE
  OTHER
}

enum NotificationType {
  COLLECTION
  EVENT
  NOTICE
  EXPENSE
  GENERAL
}

// ─── Core Models ─────────────────────────────────────────────────────

model Society {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  state       String
  pincode     String
  contactEmail String?
  contactPhone String?
  totalFlats  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  users       User[]
  flats       Flat[]
  residents   Resident[]
  collections Collection[]
  expenses    Expense[]
  events      Event[]
  notices     Notice[]
  assets      Asset[]
  calendarEvents CalendarEvent[]
  vehicles    Vehicle[]
  assetBookings AssetBooking[]

  @@index([deletedAt])
}

// ─── User & Auth ─────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  role          UserRole  @default(RESIDENT)
  avatar        String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  societyId     String
  society       Society   @relation(fields: [societyId], references: [id])
  residentId    String?   @unique
  resident      Resident? @relation(fields: [residentId], references: [id])
  notifications Notification[]
  collections   Collection[]
  expenses      Expense[]
  events        Event[]
  notices       Notice[]

  @@index([societyId])
  @@index([role])
  @@index([deletedAt])
}

// ─── Resident ────────────────────────────────────────────────────────

model Resident {
  id               String        @id @default(cuid())
  firstName        String
  lastName         String
  email            String?       @unique
  phone            String
  gender           Gender?
  dateOfBirth      DateTime?
  aadharNumber     String?
  ownershipType    OwnershipType @default(OWNER)
  familyMemberCount Int          @default(1)
  emergencyContact String?
  emergencyPhone   String?
  moveInDate       DateTime?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  societyId        String
  society          Society       @relation(fields: [societyId], references: [id])
  flatId           String
  flat             Flat          @relation(fields: [flatId], references: [id])
  user             User?
  vehicles         Vehicle[]
  assetBookings    AssetBooking[]

  @@index([societyId])
  @@index([flatId])
  @@index([deletedAt])
}

// ─── Flat ────────────────────────────────────────────────────────────

model Flat {
  id            String     @id @default(cuid())
  flatNumber    String
  block         String?
  floor         Int
  flatType      String?
  area          Float?
  bedrooms      Int?
  status        FlatStatus @default(OCCUPIED)
  monthlyDues   Decimal    @default(0) @db.Decimal(10, 2)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  societyId     String
  society       Society    @relation(fields: [societyId], references: [id])
  residents     Resident[]
  collections   Collection[]

  @@unique([societyId, flatNumber])
  @@index([societyId])
  @@index([status])
  @@index([block])
  @@index([deletedAt])
}

// ─── Vehicle ─────────────────────────────────────────────────────────

model Vehicle {
  id            String      @id @default(cuid())
  registrationNumber String
  type          VehicleType @default(CAR)
  brand         String?
  model         String?
  color         String?
  parkingSlot   String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  societyId     String
  society       Society     @relation(fields: [societyId], references: [id])
  residentId    String
  resident      Resident    @relation(fields: [residentId], references: [id])

  @@unique([societyId, registrationNumber])
  @@index([societyId])
  @@index([residentId])
  @@index([deletedAt])
}

// ─── Collection ──────────────────────────────────────────────────────

model Collection {
  id            String           @id @default(cuid())
  amount        Decimal          @db.Decimal(10, 2)
  dueDate       DateTime
  paidDate      DateTime?
  status        CollectionStatus @default(PENDING)
  month         Int
  year          Int
  notes         String?
  receiptNumber String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  societyId     String
  society       Society          @relation(fields: [societyId], references: [id])
  flatId        String
  flat          Flat             @relation(fields: [flatId], references: [id])
  collectedBy   String?
  collector     User?            @relation(fields: [collectedBy], references: [id])

  @@unique([flatId, month, year])
  @@index([societyId])
  @@index([flatId])
  @@index([status])
  @@index([month, year])
  @@index([deletedAt])
}

// ─── Expense ─────────────────────────────────────────────────────────

model Expense {
  id            String       @id @default(cuid())
  title         String
  description   String?
  amount        Decimal      @db.Decimal(10, 2)
  category      String
  vendor        String?
  invoiceNumber String?
  status        ExpenseStatus @default(PENDING)
  approvedBy    String?
  approvedAt    DateTime?
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  societyId     String
  society       Society      @relation(fields: [societyId], references: [id])
  createdBy     String
  creator       User         @relation(fields: [createdBy], references: [id])

  @@index([societyId])
  @@index([status])
  @@index([category])
  @@index([deletedAt])
}

// ─── Event ───────────────────────────────────────────────────────────

model Event {
  id            String      @id @default(cuid())
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime
  location      String?
  status        EventStatus @default(UPCOMING)
  isPublic      Boolean     @default(true)
  maxAttendees  Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  societyId     String
  society       Society     @relation(fields: [societyId], references: [id])
  createdBy     String
  creator       User        @relation(fields: [createdBy], references: [id])

  @@index([societyId])
  @@index([startDate])
  @@index([status])
  @@index([deletedAt])
}

// ─── Notice ──────────────────────────────────────────────────────────

model Notice {
  id            String         @id @default(cuid())
  title         String
  content       String
  priority      NoticePriority @default(MEDIUM)
  isPublished   Boolean        @default(true)
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  societyId     String
  society       Society        @relation(fields: [societyId], references: [id])
  createdBy     String
  creator       User           @relation(fields: [createdBy], references: [id])

  @@index([societyId])
  @@index([priority])
  @@index([isPublished])
  @@index([deletedAt])
}

// ─── Asset ───────────────────────────────────────────────────────────

model Asset {
  id              String    @id @default(cuid())
  name            String
  description     String?
  category        String
  totalQuantity   Int       @default(1)
  availableQuantity Int     @default(1)
  location        String?
  condition       String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  societyId       String
  society         Society   @relation(fields: [societyId], references: [id])
  bookings        AssetBooking[]

  @@index([societyId])
  @@index([category])
  @@index([deletedAt])
}

// ─── Asset Booking ───────────────────────────────────────────────────

enum AssetBookingStatus {
  ACTIVE
  RETURNED
  CANCELLED
}

model AssetBooking {
  id            String            @id @default(cuid())
  quantity      Int               @default(1)
  status        AssetBookingStatus @default(ACTIVE)
  borrowDate    DateTime          @default(now())
  returnDate    DateTime?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  assetId       String
  asset         Asset             @relation(fields: [assetId], references: [id])
  residentId    String
  resident      Resident          @relation(fields: [residentId], references: [id])
  societyId     String
  society       Society           @relation(fields: [societyId], references: [id])

  @@index([assetId])
  @@index([residentId])
  @@index([societyId])
  @@index([status])
}

// ─── Calendar Event ──────────────────────────────────────────────────

model CalendarEvent {
  id            String    @id @default(cuid())
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime
  allDay        Boolean   @default(false)
  color         String?
  recurring     Boolean   @default(false)
  recurrenceRule String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  societyId     String
  society       Society   @relation(fields: [societyId], references: [id])

  @@index([societyId])
  @@index([startDate])
  @@index([deletedAt])
}

// ─── Notification ────────────────────────────────────────────────────

model Notification {
  id            String           @id @default(cuid())
  title         String
  message       String
  type          NotificationType @default(GENERAL)
  isRead        Boolean          @default(false)
  link          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  userId        String
  user          User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([type])
}
